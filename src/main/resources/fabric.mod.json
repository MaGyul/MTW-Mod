{
	"schemaVersion": 1,
	"id": "mtwmod",
	"version": "${version}",
	"name": "MTWMod",
	"description": "MTW에서 사용되는 모드",
	"authors": [
		"MaGyul"
	],
	"license": "MIT",
	"icon": "assets/mtwmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.magyul.MTWMod"
		],
		"client": [
			"dev.magyul.MTWModClient"
		],
		"fabric-datagen": [
			"dev.magyul.MTWModDataGenerator"
		],
		"preLaunch": [
			{
				"adapter": "mtwmod:preload",
				"value": ""
			}
		]
	},
	"mixins": [
		"mtwmod.mixins.json",
		{
			"config": "mtwmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.7",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"voicechat": ">=1.20.4-2.5.7",
		"mtwmod-resource": ">=1.0.0"
	},
	"languageAdapters": {
		"mtwmod:preload": "dev.magyul.MTWModPreload"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_4071": [
				"dev/magyul/api/OverlayExtender"
			],
			"net/minecraft/class_2672": [
				"dev/magyul/api/ChunkDataPacketAccessor"
			]
		}
	},
	"accessWidener": "mtwmod.accesswidener"
}